# =============================================================================
# Run tests — required to clone and run Playwright
# =============================================================================

# Didaxis Studio environment URL (used as Playwright baseURL)
DIDAXIS_URL=https://your-env.didaxis.studio

# Primary admin account — used by auth.setup to create storageState
DIDAXIS_EMAIL=admin@example.com

# Password for DIDAXIS_EMAIL
DIDAXIS_PASSWORD=your-password-here

# REST API bearer token — program cleanup, API setup/teardown in tests
DIDAXIS_API_TOKEN=dt_your_api_token_here

# Optional: non-privileged account for permission / role probes (tests skip if unset)
DIDAXIS_ALT_EMAIL=viewer@example.com

# Optional: password for DIDAXIS_ALT_EMAIL
DIDAXIS_ALT_PASSWORD=your-alt-password-here

# =============================================================================
# Agent / CI setup — not needed for `npx playwright test` alone
# =============================================================================

# Cursor headless agent — used by .github/workflows/test-generation.yml
CURSOR_API_KEY=crsr_your_cursor_api_key_here

# Jira Cloud API token — backlog queries and ticket labels in CI / MCP
ATLASSIAN_API_TOKEN=your_atlassian_api_token_here

# Jira Cloud site URL (e.g. https://your-org.atlassian.net/)
ATLASSIAN_BASE_URL=https://your-org.atlassian.net/

# Atlassian account email paired with ATLASSIAN_API_TOKEN
ATLASSIAN_EMAIL=you@example.com
